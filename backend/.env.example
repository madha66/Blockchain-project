# GigLend backend (copy to backend/.env)
PORT=4000
DATABASE_URL="file:./dev.db"

# Session signing secret (any long random string)
JWT_SECRET=change-me-to-a-long-random-string

# Hardhat test account #9 (0xa0Ee7A142d267C1f36714E4a8F75612F20a79720) — local demo only, never a real key.
# Its address must hold ATTESTER_ROLE on IdentityRegistry (deploy.js grants it).
ATTESTER_PRIVATE_KEY=0x2a871d0798f97d79848a013d4936a73bf4cc922c825d33c1cf7073dff6d409c6

# Pepper mixed into idHash = keccak256(normalisedPAN || ID_PEPPER). Keep secret and stable.
ID_PEPPER=change-me-pepper

RPC_URL=http://127.0.0.1:8545
CHAIN_ID=31337

# SIWE domain/origin the frontend runs on
SIWE_DOMAIN=localhost:5173
FRONTEND_ORIGIN=http://localhost:5173

# ₹ → ETH conversion for the demo (₹1,000 ≈ 0.01 ETH)
INR_PER_ETH_DEMO=100000

# Contract addresses (written by scripts/deploy.js)
IDENTITY_REGISTRY_ADDRESS=
LOAN_MANAGER_ADDRESS=
DEFAULT_MANAGER_ADDRESS=
LENDING_POOL_ADDRESS=
SAFE_REPAY_VAULT_ADDRESS=
PAYOUT_ROUTER_ADDRESS=
POLICY_CONFIG_ADDRESS=
CREDIT_SCORE_ADDRESS=

# Admin UI wallets (comma-separated). On-chain roles are still enforced by the contracts.
ADMIN_WALLETS=0xf39Fd6e51aad88F6F4ce6aB8827279cffFb92266
# Hardhat account #8 — plays the gig platform for mock payouts and retries collection in Grace.
DEMO_PRIVATE_KEY=0xdbda1821b80551c9d65939329250298aa3472ba22feea921c0cf5d620ea67b97
WATCH_INTERVAL_MS=15000

# Auth and signup requests per minute per IP
AUTH_RATE_LIMIT=60

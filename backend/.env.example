# GigLend backend: copy to backend/.env and fill in. backend/.env is git-ignored.
PORT=4000

# MongoDB Atlas. Atlas → Network Access must allow your current IP address.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/
MONGODB_DB=giglend

# Session signing secret (any long random string)
JWT_SECRET=change-me-to-a-long-random-string

# Trusted identity issuer. Locally: Hardhat account #19 (a public test key, never a real one).
# Its address must hold ATTESTER_ROLE on IdentityRegistry (deploy.js grants it).
ISSUER_PRIVATE_KEY=0x<64-hex-characters>

# 32 random bytes as hex. Encrypts stored identifiers (AES-256-GCM) and derives the
# identity-hash salt. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Changing it changes every identityHash, so keep it stable once members exist.
ID_ENCRYPTION_KEY=<64-hex-characters>

RPC_URL=http://127.0.0.1:8545
CHAIN_ID=31337
# First block the indexer backfills from (0 for a local node).
INDEXER_START_BLOCK=0
# Set to false when running `npm run indexer` as a separate process.
INDEXER_IN_PROCESS=true

# SIWE domain/origin the frontend runs on
SIWE_DOMAIN=localhost:5173
FRONTEND_ORIGIN=http://localhost:5173

# ₹ → ETH conversion for the demo (₹1,000 ≈ 0.01 ETH)
INR_PER_ETH_DEMO=100000

# Contract addresses (written by scripts/deploy.js)
IDENTITY_REGISTRY_ADDRESS=
LOAN_MANAGER_ADDRESS=
DEFAULT_MANAGER_ADDRESS=
LENDING_POOL_ADDRESS=
SAFE_REPAY_VAULT_ADDRESS=
PAYOUT_ROUTER_ADDRESS=
POLICY_CONFIG_ADDRESS=
CREDIT_SCORE_ADDRESS=
GLP_TOKEN_ADDRESS=
RESERVE_FUND_ADDRESS=
GOVERNANCE_ADDRESS=

# Admin UI wallets (comma-separated). On-chain roles are still enforced by the contracts.
ADMIN_WALLETS=0xf39Fd6e51aad88F6F4ce6aB8827279cffFb92266
# Hardhat account #8: plays the gig platform for mock payouts and retries collection in Grace.
DEMO_PRIVATE_KEY=0x<64-hex-characters>
WATCH_INTERVAL_MS=15000

# Auth and signup requests per minute per IP
AUTH_RATE_LIMIT=60

# GigLend V2 Frontend Environment Variables
# Copy this file to frontend/.env to customize local or testnet configurations

# Local Hardhat Node RPC Endpoints
VITE_RPC_HTTP_URL=http://127.0.0.1:8545
VITE_RPC_WS_URL=

# Local Hardhat Chain ID (Default: 31337)
VITE_CHAIN_ID=31337

# Historical Block Query Start (0 for fresh local nodes)
VITE_START_BLOCK=0

# Contract Addresses (Automatically updated by `npx hardhat run scripts/deploy.js --network localhost`)
# Overrides can be specified below if running against custom deployments:
# VITE_LENDING_POOL_ADDRESS=0x9fE46736679d2D9a65F0992F2272dE9f3c7fa6e0
# VITE_CREDIT_SCORE_ADDRESS=0xe7f1725E7734CE288F8367e1Bb143E90bb3F0512
# VITE_GLP_TOKEN_ADDRESS=0x5FbDB2315678afecb367f032d93F642f64180aa3
